+/**
+ * Whether a plain `surfaceOp: 'append'` may be issued right now.
+ *
+ * An append lands at the tail of the surface. If that tail is an assistant
+ * message whose tool call is still unanswered — exactly the situation inside a
+ * tool's own `execute()`, which is where `compact_now` runs — the appended node
+ * lands *between* that call and its `tool/result`. The model-visible surface
+ * then holds an unanswered tool call interrupted by a user message, which is
+ * not a valid wire sequence: the upstream rejects the next request with
+ * HTTP 400 `INVALID_REQUEST`, and because the surface is durable, every later
+ * turn of that session fails the same way. Only the mid-turn path can hit
+ * this; `/compact` runs on an idle agent and has no open call.
+ *
+ * The window is genuinely closed: the guard runs before `compactRegion()`,
+ * whose own checkpoint node is a `replace` op that lands at the *start* of the
+ * replaced range, never at the tail.
+ *
+ * @returns true only when the cut after the last surface node is balanced.
+ *   Fails closed — if balance cannot be established, do not append.
+ */
+function canAppendToSurface(session) {
+  const nodes = session.surface?.nodes
+  if (!Array.isArray(nodes) || nodes.length === 0) return false
+  try {
+    return toolPairingBalancedAfter(session, nodes[nodes.length - 1])
+  } catch {
+    return false
+  }
+}
