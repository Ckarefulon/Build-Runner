+ * 于是讲座的考勤显示在实验课上。宁可认不出，也不能认错。
+ */
+private fun String.courseNameKey(): String = trim()
+    .replace(Regex("[\\s　]"), "")
+    .replace('（', '(')
+    .replace('）', ')')
