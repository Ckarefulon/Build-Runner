+
+    @Test
+    fun `只有整学期那一次才推进 fullScanAt`() {
+        val cached = AttendanceRecordStore.Shard(
+            termCode = "2026-2027-1", records = listOf(rec()), fetchedAt = 100L, fullScanAt = 100L,
