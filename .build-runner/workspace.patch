--- /dev/null
+++ b/app/src/main/res/layout/widget_smart_wide.xml
@@ -0,0 +1,173 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  智能卡片 · 宽形态（4×2，宽 ≥ 220dp，见 SmartLayout.Form.WIDE）。
+
+  左栏 = 一个块占四行；右栏 = 钩子（竖着排，每行 14dp）；底栏横跨全宽。
+
+  ⚠️ 控件 id 必须与 widget_smart_compact.xml **完全一致** —— RemoteViews 找不到 id 会抛
+  ActionException，整张卡片会变成「加载失败」占位，所以形态差异只能体现在排版上。
+  SmartWidgetLayoutBudgetTest 会核对两份布局的 id 集合。
+
+  主区同样 `height=0dp + weight=1` 锚底：宽卡比紧凑卡多的只是横向空间，
+  竖向预算并没有变多（110dp 还是那个上限）。
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/widget_smart_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/bg_schedule_widget"
+    android:orientation="vertical"
+    android:padding="4dp">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:orientation="horizontal">
+
+        <!-- 左栏：一块四行 -->
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_weight="1"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/widget_smart_label"
+                android:layout_width="wrap_content"
+                android:layout_height="13dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp"
+                android:visibility="gone" />
+
+            <TextView
+                android:id="@+id/widget_smart_title"
+                android:layout_width="match_parent"
+                android:layout_height="22dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface"
+                android:textSize="17sp"
+                android:textStyle="bold" />
+
+            <TextView
+                android:id="@+id/widget_smart_detail"
+                android:layout_width="match_parent"
+                android:layout_height="14dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="11sp"
+                android:visibility="gone" />
+
+            <TextView
+                android:id="@+id/widget_smart_status"
+                android:layout_width="match_parent"
+                android:layout_height="17dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface"
+                android:textSize="12sp"
+                android:textStyle="bold"
+                android:visibility="gone" />
+        </LinearLayout>
+
+        <!-- 右栏：钩子。约 96dp 宽 ⇒ 文案要短（「余额 ¥128」「考试 3 天」） -->
+        <LinearLayout
+            android:layout_width="96dp"
+            android:layout_height="match_parent"
+            android:layout_marginStart="6dp"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/widget_smart_hook1"
+                android:layout_width="match_parent"
+                android:layout_height="14dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp"
+                android:visibility="gone" />
+
+            <TextView
+                android:id="@+id/widget_smart_hook2"
+                android:layout_width="match_parent"
+                android:layout_height="14dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp"
+                android:visibility="gone" />
+
+            <TextView
+                android:id="@+id/widget_smart_hook3"
+                android:layout_width="match_parent"
+                android:layout_height="14dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp"
+                android:visibility="gone" />
+
+            <TextView
+                android:id="@+id/widget_smart_hook4"
+                android:layout_width="match_parent"
+                android:layout_height="14dp"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp"
+                android:visibility="gone" />
+        </LinearLayout>
+    </LinearLayout>
+
+    <!-- 底栏：三个位置、都在底栏，一条规则不用记「这个尺寸快捷键在哪」 -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="22dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/widget_smart_key1"
+            android:layout_width="20dp"
+            android:layout_height="20dp"
+            android:contentDescription="@string/smart_widget_name"
+            android:scaleType="fitCenter"
+            android:visibility="gone" />
+
+        <ImageView
+            android:id="@+id/widget_smart_key2"
+            android:layout_width="20dp"
+            android:layout_height="20dp"
+            android:layout_marginStart="8dp"
+            android:contentDescription="@string/smart_widget_name"
+            android:scaleType="fitCenter"
+            android:visibility="gone" />
+
+        <TextView
+            android:layout_width="0dp"
+            android:layout_height="1dp"
+            android:layout_weight="1"
+            android:importantForAccessibility="no" />
+
+        <ImageView
+            android:id="@+id/widget_smart_key3"
+            android:layout_width="20dp"
+            android:layout_height="20dp"
+            android:contentDescription="@string/smart_widget_refresh"
+            android:scaleType="fitCenter"
+            android:visibility="gone" />
+    </LinearLayout>
+
+</LinearLayout>
diff --git a/app/src/main/res/xml/smart_widget_info.xml b/app/src/main/res/xml/smart_widget_info.xml
index ed54650e..74227feb 100644
--- a/app/src/main/res/xml/smart_widget_info.xml
+++ b/app/src/main/res/xml/smart_widget_info.xml
@@ -1,4 +1,14 @@
 <?xml version="1.0" encoding="utf-8"?>
+<!--
+  智能卡片的元数据。
+
+  `minHeight=110dp` 是**上限不是配额**（§7.3）：布局那边把主区做成 0dp + weight=1，
+  内容再多也只会被裁，底栏永远留在卡内；能不能放得下由 SmartLayout 的高度预算先算清楚。
+
+  `resizeMode="horizontal|vertical"` ⇒ 用户能把它拖成 4×2、2×4，所以两套初始布局各一份，
+  `SmartWidgetProvider.onAppWidgetOptionsChanged` 会按实例的实际宽度在紧凑/宽之间切换。
+  给系统预览（选择器里那张图）用紧凑那份，因为默认就是 2×2。
+-->
 <appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
     android:label="@string/smart_widget_name"
     android:description="@string/smart_widget_desc"
@@ -7,7 +17,7 @@
     android:targetCellWidth="2"
     android:targetCellHeight="2"
     android:updatePeriodMillis="1800000"
-    android:initialLayout="@layout/widget_smart"
-    android:previewLayout="@layout/widget_smart"
+    android:initialLayout="@layout/widget_smart_compact"
+    android:previewLayout="@layout/widget_smart_compact"
     android:resizeMode="horizontal|vertical"
     android:widgetCategory="home_screen" />
diff --git a/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBlockTest.kt b/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBlockTest.kt
new file mode 100644
index 00000000..a7863a52
--- /dev/null
+++ b/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBlockTest.kt
@@ -0,0 +1,83 @@
+package com.xjtu.toolbox.widget
+
+import com.xjtu.toolbox.widget.smart.SmartArbiter
+import com.xjtu.toolbox.widget.smart.SmartBlock
+import com.xjtu.toolbox.widget.smart.SmartFacts
+import com.xjtu.toolbox.widget.smart.SmartModule
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * 块的结构（`docs/smart-widget.md` §2.3）：
+ *
+ * **一行 = 一件事**。场景（「上课中」）和标题（课名）是两件互不相干的事，不能拼成
+ * 「上课中 · 高等数学(甲)」——那会把「上课中」这整块压成一个前缀，用户要多读一遍。
+ *
+ * 同理，状态（「迟到」）**要么独占一行，要么这个块整个不出现**，
+ * 绝不做「高等数学(甲) · 迟到」这种降级（§8.1 明确说那是错的做法）。
+ */
+class SmartWidgetBlockTest {
+
+    private val course = WidgetCourse(
+        name = "高等数学(甲)", location = "主楼A-202",
+        startMinute = 610, endMinute = 720, color = 0, startSection = 3, endSection = 4,
+    )
+
+    private fun block(facts: SmartFacts): SmartBlock = SmartArbiter.card(facts).block
+
+    @Test
+    fun `场景与标题各自独立成行`() {
+        val b = block(SmartFacts(nowMinute = 650, courses = listOf(course)))
+        assertEquals("上课中", b.label)
+        assertEquals("高等数学(甲)", b.title)
+        // 谁都不是谁的前缀：拼在一起就是把两件事压成一件
+        assertTrue("场景行不许包含课名", !b.label!!.contains(b.title))
+        assertTrue("标题里不许混进场景词", !b.title.contains("上课中"))
+    }
+
+    @Test
+    fun `状态不并进标题`() {
+        val b = block(SmartFacts(nowMinute = 650, courses = listOf(course), checkedAgoMin = 1, checkedAtClock = "10:49"))
+        assertEquals("迟到", b.status)
+        assertTrue("标题里不许出现结论", !b.title.contains("迟到"))
+        // 状态行是独立字段，渲染时才和时效拼成一句
+        assertEquals("迟到 · 10:49 查过", b.statusLine)
+    }
+
+    @Test
+    fun `没有状态的块不画空行`() {
+        // 下一节课那一屏没有结论可说：status 与 statusLine 都必须是空的，
+        // 渲染侧据此把整行 GONE（不留一条空行占 17dp）
+        val b = block(SmartFacts(nowMinute = 480 + 60, courses = listOf(course)))
+        assertEquals(SmartModule.NEXT_CLASS, b.module)
+        assertNull(b.status)
+        assertNull(b.statusLine)
+    }
+
+    @Test
+    fun `一件事一个模块，钩子不与主要信息同源`() {
+        val facts = SmartFacts(
+            nowMinute = 650, courses = listOf(course),
+            balance = "¥128.60", holiday = null,
+        )
+        val card = SmartArbiter.card(facts)
+        assertEquals(SmartModule.ATTENDANCE, card.block.module)
+        assertTrue("钩子不许重复主要信息", card.hooks.none { it.module == card.block.module })
+    }
+
+    @Test
+    fun `场景行写的是场景词，不是功能名`() {
+        // 「图书馆」是场景，「座位 3F-12」才是这件事；反过来说「图书馆页」就不对了
+        val lib = com.xjtu.toolbox.library.LibrarySeatFact(
+            seat = "3F-12", area = "兴庆三层", status = "使用中",
+            actions = listOf("中途离开", "取消预约"), at = 0L,
+        )
+        val b = block(SmartFacts(nowMinute = 900, library = lib))
+        assertEquals("图书馆", b.label)
+        assertEquals("座位 3F-12", b.title)
+        assertEquals("兴庆三层", b.detail)
+        assertEquals("使用中", b.status)
+    }
+}
diff --git a/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBoundaryTest.kt b/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBoundaryTest.kt
new file mode 100644
index 00000000..bb3ebd81
--- /dev/null
+++ b/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetBoundaryTest.kt
@@ -0,0 +1,214 @@
+package com.xjtu.toolbox.widget
+
+import com.xjtu.toolbox.inbox.InboxCategories
+import com.xjtu.toolbox.inbox.InboxItem
+import com.xjtu.toolbox.library.LibrarySeatFact
+import com.xjtu.toolbox.widget.smart.SmartArbiter
+import com.xjtu.toolbox.widget.smart.SmartFacts
+import com.xjtu.toolbox.widget.smart.SmartModule
+import com.xjtu.toolbox.widget.smart.SmartRank
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * 仲裁表与联网边界（`docs/smart-widget.md` §3.1 / §6.3）。
+ *
+ * 仲裁是**有序短路**：第一个命中的就是主要信息，所以「课 > 饭点」「签到 > 找座」
+ * 两条取舍必须能在单测里摆出来断言。联网那边判的是「这一屏还欠不欠一次查询」——
+ * 一节课两个点、无课日零次，不许多问一句。
+ */
+class SmartWidgetBoundaryTest {
+
+    /** 第 3-4 节 10:10–12:00。 */
+    private val morning = WidgetCourse(
+        name = "高等数学", location = "主楼A-202",
+        startMinute = 610, endMinute = 720, color = 0, startSection = 3, endSection = 4,
+    )
+
+    /** 第 5 节 14:00–14:50（冬季表），用来当「下一节」。 */
+    private val afternoon = WidgetCourse(
+        name = "大学物理", location = "主楼B-201",
+        startMinute = 840, endMinute = 890, color = 0, startSection = 5, endSection = 5,
+    )
+
+    private fun todo(minutesLeft: Long) = InboxItem(
+        id = "lms-1", category = InboxCategories.LMS, source = "思源学堂",
+        title = "实验报告", expiresAt = 1_000_000_000L + minutesLeft * 60_000L,
+    )
+
+    private fun seat(actions: List<String>) = LibrarySeatFact(
+        seat = "3F-12", area = "兴庆三层", status = "已预约",
+        actions = actions, at = 1_000_000_000L,
+    )
+
+    private fun facts(
+        nowMinute: Int,
+        courses: List<WidgetCourse> = listOf(morning, afternoon),
+        todos: List<InboxItem> = emptyList(),
+        library: LibrarySeatFact? = null,
+        balance: String? = null,
+        holiday: String? = null,
+        scheduleDiff: String? = null,
+        ago: Int? = 1,
+        lastCheckAtMs: Long? = null,
+    ) = SmartFacts(
+        nowMinute = nowMinute,
+        nowMs = 1_000_000_000L,
+        courses = courses,
+        date = "2026-11-17",
+        todos = todos,
+        library = library,
+        balance = balance,
+        holiday = holiday,
+        scheduleDiff = scheduleDiff,
+        checkedAgoMin = ago,
+        checkedAtClock = "10:49",
+        lastCheckAtMs = lastCheckAtMs,
+    )
+
+    // ══════ 仲裁表 ══════
+
+    @Test
+    fun `课优先于饭点`() {
+        // 11:10-12:00 的第 4 节与午饭窗口重叠：缺勤改不了，饭可以晚十分钟吃
+        val lunch = WidgetCourse(
+            name = "大学物理", location = "主楼B-201",
+            startMinute = 670, endMinute = 720, color = 0, startSection = 4, endSection = 4,
+        )
+        val card = SmartArbiter.card(facts(nowMinute = 11 * 60 + 30, courses = listOf(lunch), balance = "¥128.60"))
+        assertEquals(SmartModule.ATTENDANCE, card.block.module)
+        assertEquals("上课中", card.block.label)
+        // 饭点降为钩子：余额还在，只是不占块
+        assertTrue("余额该降级成钩子", card.hooks.any { it.module == SmartModule.CAMPUS_CARD })
+    }
+
+    @Test
+    fun `待入馆签到优先于当前课`() {
+        // 座位丢了就是丢了，缺一节课还能补 —— 硬窗口压过可缓的。
+        // 这里取打卡窗口关之前（10:12），免得被「已查证的迟到」那条 P0 抢先短路。
+        val card = SmartArbiter.card(
+            facts(nowMinute = 612, library = seat(listOf("入馆签到", "取消预约"))),
+        )
+        assertEquals(SmartModule.LIBRARY, card.block.module)
+        assertEquals("座位 3F-12", card.block.title)
+    }
+
+    @Test
+    fun `两小时内截止的待办压过一切可缓的`() {
+        val card = SmartArbiter.card(facts(nowMinute = 900, todos = listOf(todo(59))))
+        assertEquals(SmartModule.TODO, card.block.module)
+        assertEquals(SmartRank.P0, card.block.rank)
+        assertEquals("还有 59 分钟", card.block.status)
+    }
+
+    @Test
+    fun `六小时内截止的待办排在课后面`() {
+        val card = SmartArbiter.card(facts(nowMinute = 650, todos = listOf(todo(300))))
+        assertEquals("上课中优先于六小时的待办", SmartModule.ATTENDANCE, card.block.module)
+        assertTrue("待办降为钩子", card.hooks.any { it.module == SmartModule.TODO })
+    }
+
+    @Test
+    fun `没课的时候按下一节、饭点、放假、兜底依次退让`() {
+        // 9:30：早饭窗口已过（6:30-9:00），下一节 10:10 在 120 分钟内 ⇒ 报下一节
+        assertEquals(
+            SmartModule.NEXT_CLASS,
+            SmartArbiter.card(facts(nowMinute = 9 * 60 + 30)).block.module,
+        )
+        // 11:30：下一节 14:00 还在 120 分钟之外 ⇒ 饭点占块（表格第 8 条不命中）
+        assertEquals(
+            SmartModule.CAMPUS_CARD,
+            SmartArbiter.card(
+                facts(nowMinute = 11 * 60 + 30, courses = listOf(afternoon), balance = "¥12.30"),
+            ).block.module,
+        )
+        // 15:00 且今天一门课都没有：放假 / 今天没课
+        assertEquals(
+            "放假",
+            SmartArbiter.card(facts(nowMinute = 15 * 60, courses = emptyList(), holiday = "校庆")).block.label,
+        )
+        // 15:00 课上完了：兜底报余额
+        val done = SmartArbiter.card(
+            facts(nowMinute = 15 * 60, courses = listOf(morning), balance = "¥8.00"),
+        )
+        assertEquals(SmartModule.CAMPUS_CARD, done.block.module)
+        assertEquals("今天的课上完了", done.block.label)
+    }
+
+    @Test
+    fun `课表变动在被课压着时降为钩子之外，不抢主要信息`() {
+        // 有课就报课；调课那句只在没课的时段占块（§3.1 第 10 条）
+        val inClass = SmartArbiter.card(facts(nowMinute = 650, scheduleDiff = "高等数学换教室"))
+        assertEquals(SmartModule.ATTENDANCE, inClass.block.module)
+
+        val idle = SmartArbiter.card(facts(nowMinute = 15 * 60, scheduleDiff = "高等数学换教室"))
+        assertEquals(SmartModule.SCHEDULE_DIFF, idle.block.module)
+        assertEquals("课表有变", idle.block.label)
+    }
+
+    @Test
+    fun `拿不到的东西不上屏`() {
+        // 什么都没有：不画占位符，也不假装「今天没课」，只报一句能解释的话
+        val card = SmartArbiter.card(SmartFacts(nowMinute = 3 * 60, courses = emptyList()))
+        assertEquals(SmartModule.HOLIDAY, card.block.module)
+        assertEquals("今天没课", card.block.label)
+        assertEquals("校园卡余额未同步", card.block.title)
+    }
+
+    // ══════ 联网边界 ══════
+
+    @Test
+    fun `没有课就一次联网都不排`() {
+        val facts = facts(nowMinute = 650, courses = emptyList(), ago = null)
+        assertEquals(SmartArbiter.CheckKind.NONE, SmartArbiter.checkNeeded(facts))
+    }
+
+    @Test
+    fun `上课前不排查询，上课那一刻才欠一次`() {
+        // 课前 20 分钟到上课之间：Q1 还没到，问回来必然是空的（废点，§6.3）
+        assertEquals(
+            SmartArbiter.CheckKind.NONE,
+            SmartArbiter.checkNeeded(facts(nowMinute = 600, ago = null)),
+        )
+        // 10:10 上课那一刻：Q1 到了却没问过 ⇒ 欠查
+        assertEquals(
+            SmartArbiter.CheckKind.DUE,
+            SmartArbiter.checkNeeded(facts(nowMinute = 610, ago = null)),
+        )
+    }
+
+    @Test
+    fun `打卡窗口关的那一刻再欠一次`() {
+        val nowMinute = 616
+        val q2 = 615
+        val dayStart = 1_000_000_000L - nowMinute * 60_000L
+        // 10:12 问过一次（Q1 之后、Q2 之前）：窗口关的那一刻还得再问
+        assertEquals(
+            SmartArbiter.CheckKind.DUE,
+            SmartArbiter.checkNeeded(facts(nowMinute, ago = 4, lastCheckAtMs = dayStart + (q2 - 3) * 60_000L)),
+        )
+        // 10:15（Q2 正点）问过：不欠了，而且刚查过 ⇒ 也不用保鲜
+        assertEquals(
+            SmartArbiter.CheckKind.NONE,
+            SmartArbiter.checkNeeded(facts(nowMinute, ago = 1, lastCheckAtMs = dayStart + q2 * 60_000L)),
+        )
+    }
+
+    @Test
+    fun `结论放超过十分钟就补查一次，措辞同时降级`() {
+        val nowMinute = 650
+        val dayStart = 1_000_000_000L - nowMinute * 60_000L
+        // 10:15 之后问过一次（所以不欠 Q2），但已经是 30 分钟前的事
+        val facts = facts(nowMinute, ago = 30, lastCheckAtMs = dayStart + 620 * 60_000L)
+        assertEquals(SmartArbiter.CheckKind.REFRESH, SmartArbiter.checkNeeded(facts))
+        assertEquals("可能迟到", SmartArbiter.card(facts).block.status)
+    }
+
+    @Test
+    fun `课程是一学期数据，锚点用开始时刻排`() {
+        val card = SmartArbiter.card(facts(nowMinute = 9 * 60 + 30))
+        assertEquals(morning.startMinute, card.block.anchor)
+        assertEquals("下一节 10:10", card.block.label)
+    }
+}
diff --git a/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetButtonTest.kt b/app/src/test/java/com/xjtu/toolbox/widget/SmartWidgetButtonTest.kt
