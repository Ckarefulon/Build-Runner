+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  智能卡片 · 紧凑形态（2×2，宽 < 220dp）。
+
+  版式（按真机反馈重排）：
+
+    ┌ 块 1（weight=1，撑满剩余高度，内容垂直居中）
+    │   场景行 ……………… [键][键]     ← 键在块里面，块整块是一个点击目标
+    │   标题
+    │   状态
+    │   细节（高度够才有）
+    ├ 1dp 分隔线（只有两个块时可见）
+    ┌ 块 2（weight=1）同上
+    └ 底部条：次要提示（weight=1）……………… [刷新]
+
+  「一块占满 / 两块各一半」是用 layout_weight 做的 —— 这样不管实例多高，卡里都不会留一大片空白。
+
+  ⚠️ 三件不能破的事：
+  1. 只能出现 RemoteViews 白名单里的控件。裸 <View>（占位撑高）不在白名单里，撞上抛
+     InflateException，桌面显示「加载失败」。撑高用空 TextView 或带 weight 的容器，
+     分隔线用 ImageView（在白名单内）。
+  2. 两套布局的控件 id 必须完全一致 —— RemoteViews 找不到 id 会抛 ActionException。
+  3. 行高写死 dp，与 SmartLayout 的常量逐条对应（SmartWidgetLayoutBudgetTest 盯着）。
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/widget_smart_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/bg_schedule_widget"
+    android:orientation="vertical"
+    android:paddingHorizontal="14dp"
+    android:paddingVertical="8dp">
+
+    <!-- ══════ 块 1 ══════ -->
+    <LinearLayout
+        android:id="@+id/widget_smart_block1"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:gravity="center_vertical"
+        android:orientation="vertical">
+
+        <!-- 场景行：左边是情境词，右边是这个块自己的快捷键 -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="16dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal">
+
+            <TextView
+                android:id="@+id/widget_smart_label1"
+                android:layout_width="0dp"
+                android:layout_height="16dp"
+                android:layout_weight="1"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp" />
+
+            <ImageView
+                android:id="@+id/widget_smart_key1a"
+                android:layout_width="18dp"
+                android:layout_height="18dp"
+                android:layout_marginStart="10dp"
+                android:contentDescription="@string/smart_widget_name"
+                android:scaleType="fitCenter"
+                android:visibility="gone" />
+
+            <ImageView
+                android:id="@+id/widget_smart_key1b"
+                android:layout_width="18dp"
+                android:layout_height="18dp"
+                android:layout_marginStart="10dp"
+                android:contentDescription="@string/smart_widget_name"
+                android:scaleType="fitCenter"
+                android:visibility="gone" />
+        </LinearLayout>
+
+        <TextView
+            android:id="@+id/widget_smart_title1"
+            android:layout_width="match_parent"
+            android:layout_height="21dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface"
+            android:textSize="17sp"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/widget_smart_status1"
+            android:layout_width="match_parent"
+            android:layout_height="17dp"
+            android:layout_marginTop="1dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface"
+            android:textSize="12sp"
+            android:textStyle="bold"
+            android:visibility="gone" />
+
+        <TextView
+            android:id="@+id/widget_smart_detail1"
+            android:layout_width="match_parent"
+            android:layout_height="15dp"
+            android:layout_marginTop="1dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface_secondary"
+            android:textSize="11sp"
+            android:visibility="gone" />
+    </LinearLayout>
+
+    <!-- 两块之间那条横线（只有一个块时 GONE） -->
+    <ImageView
+        android:id="@+id/widget_smart_divider"
+        android:layout_width="match_parent"
+        android:layout_height="1dp"
+        android:layout_marginVertical="3dp"
+        android:background="@color/widget_divider"
+        android:contentDescription="@null"
+        android:importantForAccessibility="no"
+        android:visibility="gone" />
+
+    <!-- ══════ 块 2 ══════ -->
+    <LinearLayout
+        android:id="@+id/widget_smart_block2"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:gravity="center_vertical"
+        android:orientation="vertical"
+        android:visibility="gone">
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="16dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal">
+
+            <TextView
+                android:id="@+id/widget_smart_label2"
+                android:layout_width="0dp"
+                android:layout_height="16dp"
+                android:layout_weight="1"
+                android:ellipsize="end"
+                android:includeFontPadding="false"
+                android:maxLines="1"
+                android:textColor="@color/widget_on_surface_secondary"
+                android:textSize="10sp" />
+
+            <ImageView
+                android:id="@+id/widget_smart_key2a"
+                android:layout_width="18dp"
+                android:layout_height="18dp"
+                android:layout_marginStart="10dp"
+                android:contentDescription="@string/smart_widget_name"
+                android:scaleType="fitCenter"
+                android:visibility="gone" />
+
+            <ImageView
+                android:id="@+id/widget_smart_key2b"
+                android:layout_width="18dp"
+                android:layout_height="18dp"
+                android:layout_marginStart="10dp"
+                android:contentDescription="@string/smart_widget_name"
+                android:scaleType="fitCenter"
+                android:visibility="gone" />
+        </LinearLayout>
+
+        <TextView
+            android:id="@+id/widget_smart_title2"
+            android:layout_width="match_parent"
+            android:layout_height="21dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface"
+            android:textSize="17sp"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/widget_smart_status2"
+            android:layout_width="match_parent"
+            android:layout_height="17dp"
+            android:layout_marginTop="1dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface"
+            android:textSize="12sp"
+            android:textStyle="bold"
+            android:visibility="gone" />
+
+        <TextView
+            android:id="@+id/widget_smart_detail2"
+            android:layout_width="match_parent"
+            android:layout_height="15dp"
+            android:layout_marginTop="1dp"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface_secondary"
+            android:textSize="11sp"
+            android:visibility="gone" />
+    </LinearLayout>
+
+    <!-- 内容与底部条之间那条横线：把「能点的块」和「只读的提示」分开 -->
+    <ImageView
+        android:id="@+id/widget_smart_bottom_divider"
+        android:layout_width="match_parent"
+        android:layout_height="1dp"
+        android:layout_marginTop="3dp"
+        android:background="@color/widget_divider"
+        android:contentDescription="@null"
+        android:importantForAccessibility="no" />
+
+    <!-- ══════ 底部条：次要提示 + 刷新 ══════ -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="22dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <TextView
+            android:id="@+id/widget_smart_hint"
+            android:layout_width="0dp"
+            android:layout_height="15dp"
+            android:layout_weight="1"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="@color/widget_on_surface_secondary"
+            android:textSize="10sp" />
+
+        <ImageView
+            android:id="@+id/widget_smart_refresh"
+            android:layout_width="18dp"
+            android:layout_height="18dp"
+            android:layout_marginStart="10dp"
+            android:contentDescription="@string/smart_widget_refresh"
+            android:scaleType="fitCenter"
+            android:visibility="gone" />
+    </LinearLayout>
+
+</LinearLayout>
