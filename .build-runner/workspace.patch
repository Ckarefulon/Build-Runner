+  const out = []
+  for (const line of lines) {
+    if (SYNC_LINE.test(line.trim())) continue
+    out.push(line.replace(ANSI, ''))
+  }
+  // Trim the blank lines the wrapper itself emits around the section markers.
+  while (out.length > 0 && out[0].trim() === '') out.shift()
