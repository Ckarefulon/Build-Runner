diff --git a/shared/data/src/jvmTest/kotlin/com/xjtu/toolbox/attendance/AttendanceRecordStoreShardTest.kt b/shared/data/src/jvmTest/kotlin/com/xjtu/toolbox/attendance/AttendanceRecordStoreShardTest.kt
