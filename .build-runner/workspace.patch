+      changes.push({ path: change.path.replace(/\\/g, '/'), kind: 'deleted' })
+      continue
+    }
+    if (!stats.isFile()) continue
+    const content = readFileSync(absolute)
+    const normalized = change.path.replace(/\\/g, '/')
+    changes.push({
+      path: normalized,
+      kind: change.kind,
+      from: change.from ? change.from.replace(/\\/g, '/') : null,
+      content,
+      size: content.length,
+    })
+  }
