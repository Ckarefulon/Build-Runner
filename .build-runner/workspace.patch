+  log(`starting v${SERVER_INFO.version}`)
+  if (!process.env.BUILD_RUNNER_TOKEN) {
+    log('WARNING: BUILD_RUNNER_TOKEN 未设置，所有调用都会失败')
+  } else {
+    log(`token loaded (${process.env.BUILD_RUNNER_TOKEN.length} chars)`)
+  }
