+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24">
+<!-- Calendar: hangers, a frame and three rows. -->
+    <path
+        android:fillColor="#00000000"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="1.6"
+        android:pathData="M3,5 L21,5 L21,21 L3,21 Z" />
+    <path
+        android:fillColor="#FFFFFF"
+        android:pathData="M3,5 L21,5 L21,8.4 L3,8.4 Z" />
+    <path
+        android:fillColor="#FFFFFF"
+        android:pathData="M6.4,2 L8.4,2 L8.4,6.4 L6.4,6.4 Z" />
+    <path
+        android:fillColor="#FFFFFF"
