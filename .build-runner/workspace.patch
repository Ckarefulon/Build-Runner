+/** Parse `owner/name` or a full GitHub URL into { owner, repo }. */
+export function parseSlug(slug) {
+  const value = String(slug ?? '').trim()
+  if (value === '') return null
+  const urlMatch = value.match(/github\.com[/:]([^/]+)\/([^/#?]+)/i)
