+  const changes = []
+  for (const change of parsed) {
+    if (isIgnoredByPolicy(change.path)) continue
+    const absolute = join(toplevel, change.path)
+    if (change.kind === 'deleted') {
+      changes.push({ path: change.path.replace(/\\/g, '/'), kind: 'deleted' })
