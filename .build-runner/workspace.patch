+package com.xjtu.toolbox.widget.smart
+
+import com.xjtu.toolbox.nav.AppRoute
+
+// ==================== 卡片的内容模型（纯数据，不碰 Android） ====================
+// 设计见 docs/smart-widget.md §2。这里只有形状与判据，渲染在 SmartWidgetUpdater 那一侧，
+// 所以这一整套能在普通 JVM 单测里逐条断言，而不用起模拟器。
+
+/**
+ * 卡片上一条结论是**怎么来的**。
+ *
+ * 这一项决定「渲染规则」——不是在内容上加个后缀，而是决定这一行**能不能下断言**：
+ * 学校写下的（[RECORDED]）怎么显示都行，按本机时钟推出来的（[INFERRED]）必须降级措辞并标时刻。
+ * 旧代码只有一个 `statusIsGuess` 布尔，分不出「查证过」与「没查过」——那正是
+ * 「明明刷了卡却显示迟到」的根源。
+ */
+enum class SmartEvidence {
+    /** 学校写下的结论（正常 / 迟到 / 缺勤 / 请假）：不会自己变，不用标时刻。 */
+    RECORDED,
+
+    /** 本机亲眼见到的事实（刷卡流水）：标**观测时刻**。 */
+    OBSERVED,
+
+    /** 在临界点（打卡窗口关）查证过，结论成立：标**查证时刻**，可以直说「迟到」。 */
+    VERIFIED,
+
+    /** 按本机数据 + 时钟推出来的，可能被推翻：措辞降级为「可能…」，必标时刻。 */
+    INFERRED,
+
+    /** 查过，但已经过了 [SmartArbiter.VERIFY_WINDOW_MIN] 分钟：自动降级措辞。 */
+    STALE,
+}
+
+/** 时效等级，决定排位与染色（§2.2）。 */
+enum class SmartRank { P0, P1, P2 }
+
+/**
+ * 内容模块。主要信息与次要信息**不许同源**（§4.2），去重就靠它。
+ */
+enum class SmartModule {
+    /** 这一堂课 + 考勤。 */
+    ATTENDANCE,
+
+    /** 下一节课 / 该出发了。 */
+    NEXT_CLASS,
+
+    /** 校园卡余额 / 付款码。 */
+    CAMPUS_CARD,
+
+    /** 待办（收纳里的 todo.*）。 */
+    TODO,
+
+    /** 图书馆座位。 */
+    LIBRARY,
+
+    /** 考试倒计时。 */
+    EXAM,
+
+    /** 放假 / 今天没课。 */
+    HOLIDAY,
+
+    /** 课表变动（停课 / 换教室）。 */
+    SCHEDULE_DIFF,
+
+    /** 教务通知（只当钩子，没有标题可说）。 */
+    NOTICE,
+}
+
+/**
+ * 底栏快捷键的种类。
+ *
+ * 只放种类不放图标资源：图标映射在渲染那一侧做，这样仲裁与布局这一整套纯逻辑
+ * 不必依赖 `R`，单测不碰 Android 资源。
+ *
+ * 这里**没有「空教室」**：`EmptyRoomCache` 的键是「周次 + 星期 + 节次」组合，
+ * 卡片冷启动时未必拼得出来，硬做只会显示一个过期的空教室数（M11 留到下一步）。
+ */
+enum class SmartKeyKind {
+    ATTENDANCE, REFRESH, QR, SEAT, PAYMENT, CARD, CALENDAR, SCHOOL_CALENDAR,
+    CHECKIN, INBOX, LEAVE, RETURN, CANCEL, TASK,
+}
+
+/** 底栏上的一个键（§5.2）：导航键打开某个页面，动作键后台真做一件事。 */
+sealed interface SmartKey {
+    val kind: SmartKeyKind
+
+    /** 无障碍朗读与宽卡小字都用它（「中途离开」而不是「图片」）。 */
+    val label: String
+}
+
+/** 导航键：带路由启动 App。 */
+data class NavKey(
+    override val kind: SmartKeyKind,
+    override val label: String,
+    val route: AppRoute,
+) : SmartKey
+
+/**
+ * 动作键：**不打开 App** 就把一个有后果的事做完。
+ *
+ * 座位动作只能执行「预约当前真的有这个按钮」的那个动作（[action] 来自最近一次查到的
+ * `actionUrls.keys`），所以它必须跟着落盘的那份事实走，不能写死。
+ */
+data class SeatKey(
+    override val kind: SmartKeyKind,
+    override val label: String,
+    val action: String,
+) : SmartKey
+
+/**
+ * 一个块 = 一件事的若干行（§2.3）：
+ *
+ * ```
+ * 场景    ← 这件事是什么情境（上课中 / 下一节 / 午饭时间）
+ * 标题    ← 这件事是什么
+ * 细节    ← 补充事实（地点、还剩多久）
+ * 状态    ← 结论（已刷卡 · 待结算）
+ * ```
+ *
+ * **块是内容的单位，行是排版的单位**——场景和课名两件互不相干的事不许拼在一行。
+ */
+data class SmartBlock(
+    val module: SmartModule,
+    val label: String?,
+    val title: String,
+    val detail: String? = null,
+    val status: String? = null,
+    val statusColor: Int? = null,
+    val evidence: SmartEvidence = SmartEvidence.RECORDED,
+    /** 时效说明（「刷卡 09:58」/「08:05 查过」/「上次查于 07:40」）。 */
+    val meta: String? = null,
+    val rank: SmartRank = SmartRank.P2,
+    /** 排序用的锚点（距 00:00 的分钟）：级内按它早的在前。 */
+    val anchor: Int = 0,
+    /** 点这一块去哪儿（内容块整块可点，§5.1）。 */
+    val route: AppRoute,
+) {
+    /**
+     * 状态行实际画出来的那句话：**状态 + 时效**。
+     *
+     * 拼成一行是有意的（§1.4 的样张就是「迟到 · 08:05 查过」）：分开两行的话，
+     * 110dp 的紧凑卡放不下，而时效又是这句话的一部分——「迟到」离开时刻就是过期的断言。
+     */
+    val statusLine: String?
+        get() = when {
+            status.isNullOrBlank() -> meta?.takeIf { it.isNotBlank() }
+            meta.isNullOrBlank() -> status
+            else -> "$status · $meta"
+        }
+}
+
+/**
+ * 钩子：一两句写在空闲处的短句（§2.4 规则③）。
+ *
+ * 它**只写钩子**（地点 + 数字），不写句子；空间真没了，钩子先没——它最不重要。
+ */
+data class SmartHook(
+    val module: SmartModule,
+    val text: String,
+    val rank: SmartRank,
+    val anchor: Int,
+)
+
+/** 卡片判出来的一屏：一个块 + 若干钩子 + 底栏三个键。 */
+data class SmartCard(
+    val block: SmartBlock,
+    val hooks: List<SmartHook> = emptyList(),
+    val keys: List<SmartKey> = emptyList(),
+)
diff --git a/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartFacts.kt b/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartFacts.kt
new file mode 100644
index 00000000..b0a14b5e
--- /dev/null
+++ b/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartFacts.kt
@@ -0,0 +1,65 @@
+package com.xjtu.toolbox.widget.smart
+
+import com.xjtu.toolbox.inbox.InboxItem
+import com.xjtu.toolbox.library.LibrarySeatFact
+import com.xjtu.toolbox.schedule.ExamCountdown
+import com.xjtu.toolbox.schedule.SlotAttendanceMarks
+import com.xjtu.toolbox.widget.LocalSwipe
+import com.xjtu.toolbox.widget.WidgetCourse
+
+/**
+ * 卡片一次重画时**已经读进本机的全部事实**。
+ *
+ * 这一层刻意做成一个哑数据类：读缓存（SharedPreferences / Room / DataCache）留在
+ * `SmartWidgetUpdater.factsOf`，判「这一屏画什么」留在 [SmartArbiter]——于是仲裁那套
+ * 顺序表能在普通 JVM 单测里逐条摆事实、断言结果，不用起模拟器、也不碰任何存储。
+ *
+ * 每一项都允许缺失（null / 空表），因为**拿不到就不画**是这张卡片的底线（§9.1）：
+ * 谁缺了谁那一档退让，绝不画占位符、也绝不把「没数据」显示成「没有事」。
+ */
+internal data class SmartFacts(
+    /** 距 00:00 的分钟。 */
+    val nowMinute: Int,
+    /** 当前时刻（epoch millis）：算待办剩余时间用。 */
+    val nowMs: Long = 0L,
+    /** 本机时区相对 UTC 的分钟偏移（`+08:00` ⇒ 480）：把 epoch millis 换回「几点几分」。 */
+    val zoneOffsetMinutes: Int = 480,
+    /** 今天的课（含自建日程），按开始时间排。 */
+    val courses: List<WidgetCourse> = emptyList(),
+    /** 这一学期落在本机的考勤索引；null = 没有考勤缓存。 */
+    val attendance: SlotAttendanceMarks? = null,
+    /** 今天的日期（`2026-11-18`），按日期 + 节次去考勤流水里取这一格。 */
+    val date: String = "",
+    /** 本机记下的今天那条刷卡（后台问到的第一手事实）。 */
+    val swipe: LocalSwipe? = null,
+    /** 上次**成功**问到学校是几分钟前；null = 从没问过。 */
+    val checkedAgoMin: Int? = null,
+    /** 上次成功问到的时刻（epoch millis）；判「本堂课的 Q1/Q2 还欠着」用它，跨零点也不会算错。 */
+    val lastCheckAtMs: Long? = null,
+    /** 上次成功问到的时刻（`08:05`）。 */
+    val checkedAtClock: String? = null,
+    /** 校园卡余额文本（`¥128.60`）；null = 没有缓存，卡片写 `--` 而不是 `¥0.00`。 */
+    val balance: String? = null,
+    /** 余额那份缓存是什么时候更新的（`12:41`）。 */
+    val balanceClock: String? = null,
+    /** 今日消费（`￥18.50`），饭点细节用。 */
+    val todaySpend: String? = null,
+    /** 收纳里还没办的待办（已按截止时间排）。 */
+    val todos: List<InboxItem> = emptyList(),
+    /** 图书馆座位事实（账号隔离，见 `LibrarySeatStore`）。 */
+    val library: LibrarySeatFact? = null,
+    /** 最近一场还没考完的考试。 */
+    val exam: ExamCountdown.Next? = null,
+    /** 今天放假的话是哪个节日 / 假期。 */
+    val holiday: String? = null,
+    /** 调课待报的一句摘要（`ScheduleDiff.pending`）。 */
+    val scheduleDiff: String? = null,
+    /** 教务通知有新的话的一句钩子（`教务处 · 新通知`）。 */
+    val notice: String? = null,
+) {
+    /** epoch millis → 当天的「距 00:00 的分钟」。 */
+    fun minuteOf(ms: Long): Int {
+        val raw = (ms / 60_000L + zoneOffsetMinutes) % 1440L
+        return ((raw + 1440L) % 1440L).toInt()
+    }
+}
diff --git a/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartLayout.kt b/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartLayout.kt
new file mode 100644
index 00000000..851c781b
--- /dev/null
+++ b/app/src/main/java/com/xjtu/toolbox/widget/smart/SmartLayout.kt
@@ -0,0 +1,169 @@
+package com.xjtu.toolbox.widget.smart
+
+/**
+ * 把判出来的一屏塞进卡片里：选形态、算高度预算、不够就**按块降级**。
+ *
+ * 2026-11-18 之前卡片真的会被挤出去：`widget_smart.xml` 里主区各行都是 `wrap_content`、
+ * 全书没有一处 `layout_weight`，最坏情况量出来约 181dp，而 `smart_widget_info.xml` 的
+ * `minHeight` 只有 110dp —— 超出的约 70dp 正好把底栏顶出卡片（§1.3）。
+ *
+ * 两条根因各有一条对策，都在这里定下来：
+ * 1. **布局侧**：主区 `height=0dp` + `weight=1`、底栏 `wrap_content` 锚底（见两套布局），
+ *    于是内容再多也只会被裁，不会把底栏挤出去；
+ * 2. **内容侧**：这一层按确定的预算（[CARD_HEIGHT_DP] 与下面那组行高常量）算出能放几条钩子，
+ *    放不下就按 §8.1 的顺序砍。行高写死在这里而不是量出来，是因为**预算要能在单测里断言**，
+ *    量出来的东西只有真机能验。
+ */
+object SmartLayout {
+
+    /** 卡片最小高度：`smart_widget_info.xml` 的 `minHeight`，也是「不能挤出」的红线。 */
+    const val CARD_HEIGHT_DP = 110
+
+    /** 上下内边距**各** [PAD_DP]。 */
+    const val PAD_DP = 4
+
+    const val ROW_LABEL_DP = 13
+    const val ROW_TITLE_DP = 22
+    const val ROW_DETAIL_DP = 14
+    const val ROW_STATUS_DP = 17
+    const val ROW_HOOK_DP = 14
+
+    /** 底栏：24dp 图标的触控区压到 20dp，整行 22dp。 */
+    const val ROW_KEYS_DP = 22
+    const val KEY_ICON_DP = 20
+    const val KEY_GAP_DP = 8
+
+    /** 底栏放得下的图标数（§5.6 的宽度预算：96dp 里 24dp×3 + 8dp×2 = 88dp）。 */
+    const val MAX_KEYS = 3
+
+    /** 紧凑卡的钩子行：最宽裕时也就 3 条。 */
+    const val COMPACT_MAX_HOOKS = 3
+
+    /** 宽卡右栏能竖着排几条钩子（4 × 14dp = 56dp，比左栏 66dp 还矮）。 */
+    const val WIDE_MAX_HOOKS = 4
+
+    /** 从这个宽度起算「宽卡」（§7.2 / §7.4）。 */
+    const val WIDE_MIN_WIDTH_DP = 220
+
+    /**
+     * 各行的字数上限。
+     *
+     * 为什么在 Kotlin 侧截断而不是只靠 `ellipsize="end"`：不同 ROM 的 `TextView` 省略号行为
+     * 不一致（有的把整行抹成「…」，有的干脆溢出到下一行被裁），而卡片只有 110dp 高，
+     * 一行溢出就是把下面那行顶掉。所以**先按字数收一遍**，`ellipsize` 只当第二道保险。
+     */
+    const val TITLE_MAX = 18
+    const val DETAIL_MAX = 22
+    const val STATUS_MAX = 24
+    const val HOOK_MAX = 14
+
+    /** 两个形态：一套布局一个（成对的 `widget_smart_compact.xml` / `widget_smart_wide.xml`）。 */
+    enum class Form { COMPACT, WIDE }
+
+    /**
+     * 卡片实例长宽给的是「能放下多少 dp」，按宽度挑形态。
+     *
+     * 用户可以把它拖成 4×2、2×4（`resizeMode="horizontal|vertical"`），所以形态必须跟着
+     * 实例的实际尺寸走，而不是跟着安装时的默认值走。
+     */
+    fun formOf(minWidthDp: Int): Form =
+        if (minWidthDp >= WIDE_MIN_WIDTH_DP) Form.WIDE else Form.COMPACT
+
+    /** 这一屏的高度预算。宽卡左栏只有块，钩子挂在右栏、不占高。 */
+    fun heightDp(
+        form: Form,
+        hasLabel: Boolean,
+        hasDetail: Boolean,
+        hasStatus: Boolean,
+        hooks: Int,
+    ): Int {
+        val block = (if (hasLabel) ROW_LABEL_DP else 0) +
+            ROW_TITLE_DP +
+            (if (hasDetail) ROW_DETAIL_DP else 0) +
+            (if (hasStatus) ROW_STATUS_DP else 0)
+        val hookPart = if (form == Form.COMPACT) hooks.coerceAtMost(COMPACT_MAX_HOOKS) * ROW_HOOK_DP else 0
+        return PAD_DP * 2 + block + hookPart + ROW_KEYS_DP
+    }
+
+    /**
+     * 底栏实际占的宽度（§5.6 的账）：图标 + 间距。
+     *
+     * 紧凑卡可用宽度是 110 − 左右内边距各 4 = 102dp，所以「3 个纯图标」是硬上限：
+     * 4 个要 112dp，带两个文字标签要 106dp —— 都放不下。
+     */
+    fun bottomBarWidthDp(keys: Int): Int =
+        keys * KEY_ICON_DP + (keys - 1).coerceAtLeast(0) * KEY_GAP_DP
+
+    /**
+     * 落成一屏实际要渲染的东西。**不够就整块整块地砍**（§8.1），不留半块：
+     * 砍顺序是「多余的钩子 → 钩子全砍 → 细节行 → 状态行」，标题、场景行、底栏永远不砍。
+     */
+    fun plan(card: SmartCard, form: Form): Plan {
+        val maxHooks = if (form == Form.COMPACT) COMPACT_MAX_HOOKS else WIDE_MAX_HOOKS
+        val hooks = card.hooks.map { clamp(it.text, HOOK_MAX)!! }.take(maxHooks)
+        val keys = card.keys.take(MAX_KEYS)
+        var block = card.block
+
+        fun fits(candidate: SmartBlock, hookCount: Int): Boolean = heightDp(
+            form = form,
+            hasLabel = !candidate.label.isNullOrBlank(),
+            hasDetail = !candidate.detail.isNullOrBlank(),
+            hasStatus = candidate.statusLine != null,
+            hooks = hookCount,
+        ) <= CARD_HEIGHT_DP
+
+        var used = hooks.size
+        while (used > 0 && !fits(block, used)) used--
+        // 钩子让完还放不下，才动细节行（细节随情境变，本来就可以没有）
+        if (!fits(block, 0)) block = block.copy(detail = null)
+        // 状态行最后才动；状态要么独占一行，要么这个块整个不出现 —— 绝不和标题挤一行
+        if (!fits(block, 0)) block = block.copy(status = null, meta = null)
+
+        // 排版前把长文案收一遍（见 TITLE_MAX 那组常量的注释）。
+        // 状态行按**整句**收：它已经把「结论 + 时效」拼成一句，分开收会把「查于 10:12」截掉，
+        // 那就等于又变回一句没有时刻的断言。
+        block = block.copy(
+            label = clamp(block.label, DETAIL_MAX),
+            title = clamp(block.title, TITLE_MAX)!!,
+            detail = clamp(block.detail, DETAIL_MAX),
+            status = clamp(block.statusLine, STATUS_MAX),
+            meta = null,
+        )
+
+        return Plan(
+            form = form,
+            block = block,
+            hooks = hooks.take(used),
+            keys = keys,
+            heightDp = heightDp(
+                form = form,
+                hasLabel = !block.label.isNullOrBlank(),
+                hasDetail = !block.detail.isNullOrBlank(),
+                hasStatus = block.statusLine != null,
+                hooks = used,
+            ),
+        )
+    }
+
+    /**
+     * 按字数收一行字：超了就截断并补一个省略号。
+     *
+     * 只当**排版保险**用，不改语义 —— 所以截断点后面那个省略号很重要：
+     * 少一个字符就少一个字的可信度，用户看到「…」才知道后面还有、不是学校只给了这些。
+     */
+    fun clamp(text: String?, max: Int): String? = when {
+        text.isNullOrBlank() -> null
+        text.length <= max -> text
+        max <= 1 -> "…"
+        else -> text.take(max - 1) + "…"
+    }
+
+    /** 一屏要画的东西（块可能已降级，钩子已按预算裁过）。 */
+    data class Plan(
+        val form: Form,
+        val block: SmartBlock,
+        val hooks: List<String>,
+        val keys: List<SmartKey>,
+        val heightDp: Int,
+    )
+}
